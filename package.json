{
  "name": "univo-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types \"tests/*.test.ts\"",
    "qa:visual": "node scripts/visual-qa.mjs",
    "og:images": "node scripts/og-images.mjs",
    "brand:lockups": "node scripts/brand/generate-lockups.mjs",
    "brand:sync-icons": "node scripts/brand/sync-icons.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.0",
    "playwright": "1.64.1",
    "typescript": "~5.9.3"
  }
}
