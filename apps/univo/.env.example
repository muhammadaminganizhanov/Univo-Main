# ─── Site environment ───────────────────────────────────────────────
# staging (default) → noindex, nofollow, staging form copy.
# production → indexing allowed ONLY when SITE_ENV=production AND SITE_URL is set.
SITE_ENV=staging

# Public origin of the site (canonical, metadata). Domains are not purchased: never hardcode them.
SITE_URL=

# ─── Ecosystem links (master site → independent websites) ───────────────
# Every UNIVO entity is an independent site on its own domain. Links are plain external URLs.
# Unset = no public site yet:
#   TECH / PRODUCTION → the UNIVO contact form with the direction preselected ("site in progress");
#   RETAIL / SLOT     → the early-access page on the master site.
TECH_URL=
PRODUCTION_URL=
RETAIL_URL=
SLOT_URL=

# ─── Lead delivery (contact + early access forms) ────────────────────
# staging → validated on the server, NOT delivered anywhere. UI says so honestly.
# No real channel (CRM / email / Telegram) is connected yet.
LEAD_DELIVERY=staging
