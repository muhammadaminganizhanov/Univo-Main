{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "univo": {
      "root": "apps/univo",
      "framework": "nextjs",
      "installCommand": "npx --yes pnpm@12.11.2 install --frozen-lockfile"
    },
    "tech": {
      "root": "apps/tech",
      "framework": "nextjs",
      "installCommand": "npx --yes pnpm@12.11.2 install --frozen-lockfile"
    },
    "production": {
      "root": "apps/production",
      "framework": "nextjs",
      "installCommand": "npx --yes pnpm@12.11.2 install --frozen-lockfile"
    }
  },
  "rewrites": [
    { "source": "/tech", "destination": { "service": "tech" } },
    { "source": "/tech/(.*)", "destination": { "service": "tech" } },
    { "source": "/production", "destination": { "service": "production" } },
    { "source": "/production/(.*)", "destination": { "service": "production" } },
    { "source": "/(.*)", "destination": { "service": "univo" } }
  ]
}
